# Copy this file to .env and adjust values as needed.
# .env is gitignored - never commit real secrets or deployment-specific values.

# Path to the trained model file. Relative to backend/ folder.
MODEL_PATH=model/final_model.h5

# The frontend origin allowed to call this API (CORS).
# Use 5173 for Vite (default), 3000 for Create React App.
FRONTEND_URL=http://localhost:5173

# Port the Flask server binds to locally.
# On most cloud platforms (Render, etc.) this is injected automatically -
# app.py already reads PORT from the environment, so no code change needed.
PORT=5000

# Maximum upload size in bytes. 10485760 = 10 MB.
MAX_CONTENT_LENGTH=10485760

# Predictions below this confidence are relabeled "uncertain" in the response.
CONFIDENCE_THRESHOLD=0.50
